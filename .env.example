# Path to the Blender executable. Required for the unfolding step.
# Examples:
#   Windows : C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
#   Windows portable : D:\Apps\Blender\blender.exe
#   macOS   : /Applications/Blender.app/Contents/MacOS/Blender
#   Linux   : /usr/bin/blender
BLENDER_PATH=

# Hugging Face Space ID to use for image -> 3D.
# Defaults are tried in order. Override here to force one.
# Good options:
#   stabilityai/TripoSR
#   tencent/Hunyuan3D-2
#   JeffreyXiang/TRELLIS
HF_SPACE_ID=stabilityai/TripoSR

# Optional Hugging Face token (raises rate limits / required for some Spaces).
# Get a free one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Target face count for the low-poly papercraft mesh.
# 40-120 is a sweet spot. Lower = easier to assemble, blockier look.
TARGET_FACES=80

# Page size for the printable template: A4 or LETTER
PAGE_SIZE=A4
