# Path to the Blender executable. Required for the unfolding step.
# Examples:
#   Windows : C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
#   Windows portable : D:\Apps\Blender\blender.exe
#   macOS   : /Applications/Blender.app/Contents/MacOS/Blender
#   Linux   : /usr/bin/blender
BLENDER_PATH=

# Hugging Face Space ID to use for image -> 3D.
# Verified working as of 2026-04 (re-run probe_spaces.py if this changes):
#   tencent/Hunyuan3D-2     <- recommended primary, fast, returns GLB directly
#   JeffreyXiang/TRELLIS    <- higher quality, slower (3-step internal flow)
HF_SPACE_ID=tencent/Hunyuan3D-2

# Hugging Face tokens. Comma-separated to rotate through multiple free
# accounts (each has its own ~5 min/day ZeroGPU pool).
#   single: HF_TOKEN=hf_xxxxxxxxxxxxx
#   stacked: HF_TOKEN=hf_aaaa,hf_bbbb,hf_cccc
HF_TOKEN=

# Generate the model with textures (color)?
#   true  -> uses /generation_all (~90 GPU sec/call, 2-3 textured runs/day on free)
#   false -> uses /shape_generation (~30 GPU sec/call, 8-12 outline runs/day)
WITH_TEXTURE=false

# Target face count for the low-poly papercraft mesh.
# 25-50 is the assembly sweet spot. Lower = fewer pieces, blockier look.
# Higher = more detail but turns into a 50+ island nightmare to glue together.
TARGET_FACES=35

# Page size for the printable template: A4 or LETTER
PAGE_SIZE=A4
